# Copy to .env.local and fill in. Never commit real values.
# On Vercel, add these under Project -> Settings -> Environment Variables.

# MongoDB Atlas connection string (server only)
MONGODB_URI=

# Clerk (https://dashboard.clerk.com -> API Keys)
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/review
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/review

# Cloudinary (server only)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional, development only: override the 24-hour wait (in seconds) for testing.
# Ignored in production builds. Do not set this on Vercel.
# WAITING_PERIOD_SECONDS=1
